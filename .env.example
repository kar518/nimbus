# Copy this file to `.env` and adjust values for your environment.
# `.env` is gitignored — never commit real secrets.

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
PROJECT_NAME=Nimbus
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=DEBUG

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Generate a real one with: openssl rand -hex 32
SECRET_KEY=change-me-to-a-random-64-char-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Optional explicit worker registration secret; otherwise derived from SECRET_KEY.
WORKER_API_TOKEN=
# Required for first administrator setup outside ENVIRONMENT=local.
SETUP_TOKEN=

# Comma-separated list of allowed frontend origins
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=nimbus
POSTGRES_PASSWORD=nimbus
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_DB=nimbus
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# ---------------------------------------------------------------------------
# Redis / Celery
# ---------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

CELERY_TASK_DEFAULT_QUEUE=nimbus.default

# ---------------------------------------------------------------------------
# Scheduler / worker liveness
# ---------------------------------------------------------------------------
WORKER_HEARTBEAT_INTERVAL_SECONDS=15
WORKER_HEARTBEAT_TIMEOUT_SECONDS=45
SCHEDULER_POLL_INTERVAL_SECONDS=5

# ---------------------------------------------------------------------------
# Frontend (consumed by Vite at build time — must be prefixed VITE_)
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=/api/v1
VITE_WS_BASE_URL=/api/v1

# ---------------------------------------------------------------------------
# pgAdmin (optional dev convenience service)
# ---------------------------------------------------------------------------
PGADMIN_DEFAULT_EMAIL=admin@nimbus.local
PGADMIN_DEFAULT_PASSWORD=admin
